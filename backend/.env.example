# Copy this file to ".env" and fill in the real values there. Never commit .env.

# Neon → project → Connection string (Postgres), the "pooled" one
DATABASE_URL="PASTE-THE-CONNECTION-STRING-HERE"

# Neon → Object storage: bucket for product photos (and order XML files in orders/)
STORAGE_BUCKET="photos"

# Signs the login cookies: a long random value, e.g. from
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="PASTE-A-LONG-RANDOM-VALUE-HERE"
