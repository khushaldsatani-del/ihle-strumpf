    "customer:password": "node --env-file=.env src/scripts/setCustomerPassword.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  },
  "engines": {
    "node": "24.x"
  }
}
