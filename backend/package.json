{
  "name": "ihle-webshop-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "db:check": "node --env-file=.env src/scripts/checkDb.js",
    "db:migrate": "node --env-file=.env src/scripts/migrate.js",
    "import": "node --env-file=.env src/scripts/importFile.js",
    "admin:create": "node --env-file=.env src/scripts/createAdmin.js",
